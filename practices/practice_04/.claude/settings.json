{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["vkusvill", "vv-collections"],
  "permissions": {
    "allow": [
      "Bash(sh scripts/check.sh)",
      "Bash(sh scripts/check.sh *)",
      "Bash(node .claude/skills/tdd-go/scripts/tdd.mjs *)",
      "Bash(sh scripts/dev-backend.sh)",
      "Bash(curl -s http://127.0.0.1:8080/*)",
      "mcp__vkusvill__vkusvill_products_search",
      "mcp__vkusvill__vkusvill_product_details",
      "mcp__vv-collections__search_collections",
      "mcp__vv-collections__get_collection",
      "mcp__vv-collections__list_tags"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/check-after-edit.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
